{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.dcmobilenotary.net/schemas/quote.v3.schema.json",
  "title": "DCMN Get a Quote request, schema quote.v3",
  "type": "object",
  "required": ["schema_version", "form_version", "submission_id", "locale", "page", "timing",
               "services", "contact", "consent"],
  "properties": {
    "schema_version": {"const": "quote.v3"},
    "form_version": {"type": "string", "minLength": 1, "maxLength": 40},
    "submission_id": {"type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "locale": {"enum": ["en", "es"]},
    "page": {"type": "object", "required": ["url", "path"], "additionalProperties": false,
      "properties": {
        "url": {"type": "string", "maxLength": 1000},
        "path": {"type": "string", "maxLength": 255},
        "referrer_path": {"type": ["string", "null"], "maxLength": 255}}},
    "entry": {"$ref": "#/$defs/entry"},
    "timing": {"type": "object", "required": ["submitted_at", "elapsed_ms"], "additionalProperties": false,
      "properties": {
        "started_at": {"type": ["string", "null"], "format": "date-time"},
        "submitted_at": {"type": "string", "format": "date-time"},
        "elapsed_ms": {"type": "integer", "minimum": 0}}},
    "services": {"type": "array", "minItems": 1, "maxItems": 11,
      "items": {"$ref": "#/$defs/serviceLine"}},
    "price_notes": {"type": "array", "uniqueItems": true, "items": {"enum": ["other_states"]}},
    "contact": {"$ref": "#/$defs/contact"},
    "consent": {"$ref": "#/$defs/consent"},
    "files": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/file"}},
    "attribution": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/attribution"}]},
    "turnstile_token": {"type": ["string", "null"], "maxLength": 4096},
    "website_confirm": {"type": "string", "maxLength": 0},
    "fax": {"type": "string", "maxLength": 0},
    "client": {"type": "object", "additionalProperties": false,
      "properties": {
        "tz": {"type": ["string", "null"], "maxLength": 64},
        "viewport_w": {"type": ["integer", "null"], "minimum": 0},
        "ga_client_id": {"type": ["string", "null"], "maxLength": 64}}}
  },
  "$defs": {
    "serviceKey": {"enum": ["apostille", "embassy", "translation", "fbi", "retrieval", "fingerprinting",
                            "mobile-notary", "ron", "office-notary", "i9", "other"]},
    "iso2": {"type": "string", "pattern": "^[A-Z]{2}$"},
    "count": {"type": "integer", "minimum": 1, "maximum": 99},
    "language": {"type": "string", "minLength": 2, "maxLength": 64,
      "description": "languages.json slug (english, spanish, certified-portuguese, ..., other) or the v5 English name"},
    "entry": {"type": "object", "additionalProperties": false,
      "properties": {
        "type": {"enum": ["direct", "url_param", "group", "referrer", "guide"]},
        "params": {"type": "object", "additionalProperties": false,
          "properties": {
            "service": {"type": ["string", "null"], "maxLength": 100},
            "doc": {"type": ["string", "null"], "maxLength": 100},
            "group": {"type": ["string", "null"], "maxLength": 100},
            "country": {"type": ["string", "null"], "maxLength": 100},
            "state": {"type": ["string", "null"], "maxLength": 100},
            "speed": {"type": ["string", "null"], "maxLength": 100}}},
        "preselected": {"type": "array", "maxItems": 11, "items": {"$ref": "#/$defs/serviceKey"}},
        "bad_params": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 40}},
        "cta_id": {"type": ["string", "null"], "maxLength": 100},
        "cta_page": {"type": ["string", "null"], "maxLength": 255}}},
    "priceShown": {"type": "object", "required": ["kind", "text"], "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["from", "review", "route_pending"]},
        "amount_usd": {"type": ["integer", "null"]},
        "tier": {"enum": ["federal", "dc", null]},
        "per_document_usd": {"type": ["integer", "null"]},
        "plus_embassy_fee": {"type": "boolean"},
        "text": {"type": "string", "maxLength": 200}}},
    "route": {"type": "object", "required": ["country", "expected", "status"], "additionalProperties": false,
      "properties": {
        "country": {"$ref": "#/$defs/iso2"},
        "expected": {"enum": ["apostille", "embassy"]},
        "status": {"enum": ["pending", "kept"]},
        "clash": {"type": "boolean"}}},
    "serviceLine": {"type": "object",
      "required": ["service", "position", "source", "answers", "addons", "price_shown"],
      "additionalProperties": false,
      "properties": {
        "service": {"$ref": "#/$defs/serviceKey"},
        "position": {"type": "integer", "minimum": 1, "maximum": 11},
        "source": {"enum": ["user", "picker", "url", "referrer", "guide", "addon", "tip", "route_switch"]},
        "addon_of": {"enum": ["apostille", "embassy", null]},
        "switched_from": {"enum": ["apostille", "embassy", null]},
        "answers": {"type": "object"},
        "answer_source": {"type": "object",
          "additionalProperties": {"enum": ["user", "url", "referrer", "guide", "route_switch"]}},
        "addons": {"type": "array", "maxItems": 1, "items": {"const": "translation"}},
        "route": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/route"}]},
        "price_shown": {"$ref": "#/$defs/priceShown"},
        "summary": {"type": ["string", "null"], "maxLength": 300}},
      "allOf": [
        {"if": {"properties": {"service": {"const": "apostille"}}},
         "then": {"properties": {"answers": {"type": "object", "additionalProperties": false, "properties": {
           "doc": {"enum": ["fbi_report", "naturalization", "federal_other", "vital", "education", "court",
                            "corporate", "notarized", "other", "unsure"]},
           "country": {"$ref": "#/$defs/iso2"},
           "state": {"type": "string", "pattern": "^([A-Z]{2}|unsure)$"},
           "fbi_pdf": {"enum": ["yes", "printout", "not_yet"]},
           "count": {"$ref": "#/$defs/count"}}}}}},
        {"if": {"properties": {"service": {"const": "embassy"}}},
         "then": {"properties": {"answers": {"type": "object", "additionalProperties": false, "properties": {
           "kind": {"enum": ["personal", "corporate", "both", "unsure"]},
           "country": {"$ref": "#/$defs/iso2"},
           "count": {"$ref": "#/$defs/count"},
           "doc_from_apostille": {"enum": ["fbi_report", "naturalization", "federal_other", "vital", "education",
                                           "court", "corporate", "notarized", "other", "unsure"]}}}}}},
        {"if": {"properties": {"service": {"const": "translation"}}},
         "then": {"properties": {"answers": {"type": "object", "additionalProperties": false, "properties": {
           "from": {"$ref": "#/$defs/language"},
           "to": {"$ref": "#/$defs/language"},
           "kind": {"enum": ["certified_digital", "notarized_wet", "traduccion_jurada", "unsure"]},
           "pages": {"$ref": "#/$defs/count"}}}}}},
        {"if": {"properties": {"service": {"const": "fbi"}}},
         "then": {"properties": {"answers": {"type": "object", "additionalProperties": false, "properties": {
           "apostille": {"enum": ["yes", "no", "unsure"]},
           "where": {"enum": ["dc", "arlington", "mobile", "unsure"]},
           "people": {"$ref": "#/$defs/count"}}}}}},
        {"if": {"properties": {"service": {"const": "retrieval"}}},
         "then": {"properties": {"answers": {"type": "object", "additionalProperties": false, "properties": {
           "record": {"type": "string", "minLength": 1, "maxLength": 1000}}}}}},
        {"if": {"properties": {"service": {"const": "fingerprinting"}}},
         "then": {"properties": {"answers": {"type": "object", "additionalProperties": false, "properties": {
           "type": {"enum": ["livescan", "fd258", "atf", "fdle", "unsure"]},
           "where": {"enum": ["office", "mobile", "unsure"]},
           "people": {"$ref": "#/$defs/count"}}}}}},
        {"if": {"properties": {"service": {"const": "mobile-notary"}}},
         "then": {"properties": {"answers": {"type": "object", "additionalProperties": false, "properties": {
           "doc": {"enum": ["poa", "real_estate", "facility", "affidavit", "estate", "other", "unsure", "contract"]},
           "zip": {"type": "string", "pattern": "^\\d{5}$"},
           "when": {"enum": ["today", "tomorrow", "this_week", "flexible"]}}}}}},
        {"if": {"properties": {"service": {"const": "ron"}}},
         "then": {"properties": {"answers": {"type": "object", "additionalProperties": false, "properties": {
           "doc": {"enum": ["poa", "affidavit", "contract", "real_estate", "will_trust", "other", "unsure"]},
           "apostille": {"enum": ["yes", "no", "unsure"]}}}}}},
        {"if": {"properties": {"service": {"const": "office-notary"}}},
         "then": {"properties": {"answers": {"type": "object", "additionalProperties": false, "properties": {
           "doc": {"enum": ["poa", "affidavit", "estate", "contract", "other", "unsure"]},
           "office": {"enum": ["dc", "arlington", "ny", "any"]}}}}}},
        {"if": {"properties": {"service": {"const": "i9"}}},
         "then": {"properties": {"answers": {"type": "object", "maxProperties": 0}}}},
        {"if": {"properties": {"service": {"const": "other"}}},
         "then": {"properties": {"answers": {"type": "object", "additionalProperties": false, "properties": {
           "text": {"type": "string", "minLength": 1, "maxLength": 1000}}}}}}
      ]},
    "contact": {"type": "object", "required": ["full_name", "email", "phone"], "additionalProperties": false,
      "properties": {
        "full_name": {"type": "string", "minLength": 2, "maxLength": 100},
        "email": {"type": "string", "maxLength": 254},
        "phone": {"type": "string", "maxLength": 40},
        "preferred_channel": {"enum": ["call", "text", "whatsapp", "email", null]},
        "when": {"enum": ["standard", "asap", "by_date", "unsure", null]},
        "deadline": {"type": ["string", "null"], "format": "date"},
        "message": {"type": ["string", "null"], "maxLength": 2000}}},
    "consent": {"type": "object",
      "required": ["terms_method", "terms_version", "whatsapp_opt_in", "sms_opt_in", "consent_text_version"],
      "additionalProperties": false,
      "properties": {
        "terms_method": {"const": "statement"},
        "terms_version": {"type": "string", "maxLength": 40},
        "whatsapp_opt_in": {"type": "boolean"},
        "sms_opt_in": {"type": "boolean"},
        "consent_text_version": {"type": "string", "maxLength": 60}}},
    "file": {"type": "object", "required": ["upload_id"], "additionalProperties": false,
      "properties": {
        "upload_id": {"type": "string", "format": "uuid"},
        "name": {"type": "string", "maxLength": 255},
        "size": {"type": "integer", "minimum": 1, "maximum": 10485760},
        "type": {"enum": ["application/pdf", "image/jpeg", "image/png", "image/heic"]}}},
    "attribution": {"type": "object",
      "properties": {
        "source": {"type": ["string", "null"]}, "medium": {"type": ["string", "null"]},
        "campaign": {"type": ["string", "null"]}, "utm_content": {"type": ["string", "null"]},
        "utm_term": {"type": ["string", "null"]}, "gclid": {"type": ["string", "null"]},
        "fbclid": {"type": ["string", "null"]}, "msclkid": {"type": ["string", "null"]},
        "landing_page": {"type": ["string", "null"]}, "referrer_domain": {"type": ["string", "null"]},
        "device_type": {"enum": ["mobile", "tablet", "desktop", null]},
        "first_visit_at": {"type": ["string", "null"]},
        "visit_count": {"type": ["integer", "null"]}, "pages_viewed": {"type": ["integer", "null"]},
        "lead_url": {"type": ["string", "null"], "maxLength": 255}}}
  }
}
